{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3307;Database=porachki;User=porachki;Password=porachki;CharSet=utf8mb4;"
  },
  "MySqlServerVersion": "8.4.0",
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Estimates": {
    "AnthropicApiKey": "",
    "Model": "claude-sonnet-5-5",
    "MaxOutputTokens": 16000,
    "PriceInputPerMTok": 2,
    "PriceOutputPerMTok": 10,
    "MaxTextChars": 600000,
    "MaxFiles": 60,
    "MaxFileMb": 40,
    "MaxTotalMb": 250,
    "MaxNativePdfs": 3,
    "MaxNativePdfMb": 15,
    "MaxEstimatesPerDay": 30
  },
  "Sync": {
    "Enabled": true,
    "AdminApiKey": "change-me",
    "RetentionDays": 30,
    "NoDeadlineActiveDays": 45,
    "Eop": {
      "Enabled": true,
      "IntervalHours": 6,
      "BackfillDays": 60,
      "RecheckDays": 3,
      "DailyFolderUrlTemplate": "https://storage.eop.bg/open-data-{date}/",
      "TenderUrlTemplate": "https://app.eop.bg/today/{id}"
    },
    "Ted": {
      "Enabled": true,
      "IntervalHours": 2,
      "SearchUrl": "https://api.ted.europa.eu/v3/notices/search",
      "NoticeUrlTemplate": "https://ted.europa.eu/bg/notice/-/detail/{id}",
      "Query": "notice-type IN (cn-standard cn-social cn-desg pin-cfc-standard pin-cfc-social)",
      "PageSize": 100,
      "DelayMs": 1100,
      "MaxPages": 2000,
      "IncrementalOverlapDays": 2,
      "Languages": [ "bul", "eng" ],
      "Fields": [
        "publication-number",
        "procedure-identifier",
        "notice-title",
        "notice-type",
        "publication-date",
        "contract-nature",
        "procedure-type",
        "buyer-name",
        "buyer-country",
        "buyer-city",
        "classification-cpv",
        "deadline-receipt-tender-date-lot",
        "estimated-value-proc",
        "estimated-value-cur-proc"
      ]
    }
  }
}
